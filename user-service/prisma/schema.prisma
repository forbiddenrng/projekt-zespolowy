//   certificate Certificate @relation(fields: [certificate_id], references: [id])
// }
// (1:n)
model Abilities {
  id      Int    @id @default(autoincrement())
  user_id Int
  name    String @db.VarChar(255)

  users User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

