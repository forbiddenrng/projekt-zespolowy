// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  auth0_id  String @unique @db.VarChar(255)
  name  String @db.VarChar(100)
  surname String @db.VarChar(100)
  phone_number String @unique @db.VarChar(9)
  email String @unique @db.VarChar(150)
  city String @db.VarChar(100)
  profile_summary String? @db.Text

  links Link[]
  educations Education[]
  work_experiences Work_Experience[]
  user_languages User_Languages[]
  user_certificates User_Certificate[]
  user_technical_abilities User_Technical_Abilities[]
}

model Link{
  id Int @id @default(autoincrement())
  user_id Int
  linkString String @db.VarChar(150)

  user User @relation(fields: [user_id], references: [id])
}

model Education{
  id Int @id @default(autoincrement())
  user_id Int
  school_name String@db.VarChar(100)
  major String @db.VarChar(100)
  degree String @db.VarChar(20)
  begin_date DateTime
  end_date DateTime

  user User @relation(fields: [user_id], references: [id])
}

model Work_Experience{
  id Int @id @default(autoincrement())
  user_id Int 
  company_name String @db.VarChar(150)
  position String @db.VarChar(150)
  begin_date DateTime
  end_date DateTime
  description String @db.Text

  user User @relation(fields: [user_id], references: [id])
}

model Languages{
  id Int @id @default(autoincrement())
  name String @db.VarChar(50)
  level String @db.VarChar(6)

  user_languages User_Languages[]
}

model User_Languages{
  id Int @id @default(autoincrement())
  user_id Int
  language_id Int

  user User @relation(fields: [user_id], references: [id])
  language Languages @relation(fields: [language_id], references: [id])
}

model Certificate{
  id Int @id @default(autoincrement())
  name String @db.VarChar(100)

  user_certificate User_Certificate[]
}

model User_Certificate{
  id Int @id @default(autoincrement())
  user_id Int
  certificate_id Int

  user User @relation(fields: [user_id], references: [id])
  certificate Certificate @relation(fields: [certificate_id], references: [id])
}

model Technical_Abilities{
  id Int @id @default(autoincrement())
  name String @db.VarChar(100)

  user_technical_abilities User_Technical_Abilities[]
}

model User_Technical_Abilities{
  id Int @id @default(autoincrement())
  user_id Int
  technical_ability_id Int

  user User @relation(fields: [user_id], references: [id])
  technical_ability Technical_Abilities @relation(fields: [technical_ability_id], references: [id])
}
